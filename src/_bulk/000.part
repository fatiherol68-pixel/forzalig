<!-- Sentry hata izleme: DSN doluysa, sayfa yüklendikten SONRA boşta tembel yüklenir (açılış hızını etkilemez). -->
<script>
  window.__FL_SENTRY_DSN = "https://b32c8ee7debe3979c3751c186de7e639@o4511704229281792.ingest.de.sentry.io/4511704256479312"; // Sentry projesi DSN'i (boşsa Sentry kapalı)
  window.__FL_RELEASE = "FL_SW_SURUM"; // derle.js bunu sürüm damgasıyla değiştirir → Sentry "release" (kaynakta placeholder kalır)
  // Push bildirim VAPID public anahtarı (boşsa telefon push'u KAPALI; app-içi bildirim yine çalışır).
  // Üretmek için: npx web-push generate-vapid-keys → public key'i buraya, private'ı Supabase Edge Function secret'ına.
  window.__FL_VAPID_PUBLIC = "BLYy3N_SDkwLvq-MOdHfiR8-mDIgZcYM21gzP4h8oFYIgvAA-oxwsSMl4oZky7Nlz5hhpeqO4HbJ7qYs6ui5fz8";
  (function(){
    var dsn = window.__FL_SENTRY_DSN;
    if(!dsn) return;
    function baslat(){
      var s = document.createElement("script");
      s.src = "https://browser.sentry-cdn.com/7.120.3/bundle.min.js";
      s.crossOrigin = "anonymous";
      s.onload = function(){
        if(!window.Sentry) return;
        var rel = window.__FL_RELEASE;
        window.Sentry.init({
          dsn: dsn,
          release: (rel && rel.indexOf("FL_SW_")<0) ? rel : undefined, // yalnız gerçek sürüm damgası varsa
          environment: "production",
          tracesSampleRate: 0,          // performans izleme kapalı (ücretsiz kotayı korur)
          replaysSessionSampleRate: 0,  // oturum tekrarı kapalı
          replaysOnErrorSampleRate: 0,
          // B1 — GÜRÜLTÜ FİLTRESİ: kotayı yiyen anlamsız/harici hatalar hiç gönderilmesin
          ignoreErrors: [
            "ResizeObserver loop limit exceeded",
            "ResizeObserver loop completed with undelivered notifications",
            "Non-Error promise rejection captured",
            "AbortError", "The operation was aborted",
            /Load failed/i, /NetworkError/i, /Failed to fetch/i, /Importing a module script failed/i
          ],
          denyUrls: [ /^chrome-extension:\/\//i, /^moz-extension:\/\//i, /safari-web-extension:/i, /extensions\//i ],
          // B1 — KOTA KORUMASI: oturum başına en çok 12 olay (döngüye giren hata 5.000/ay hakkını bitirmesin) + PII temizliği
          beforeSend: function(event){
            try{
              window.__FL_SN = (window.__FL_SN||0) + 1;
              if(window.__FL_SN > 12) return null;
              if(event.user){ delete event.user.email; delete event.user.ip_address; delete event.user.username; }
            }catch(e){}
            return event;
          }
        });
      };
      document.head.appendChild(s);
    }
    var boslaYukle = function(){ (window.requestIdleCallback || function(f){ setTimeout(f, 1); })(baslat); };
    if(document.readyState === "complete") boslaYukle();
    else window.addEventListener("load", boslaYukle);
  })();
</script>
<!-- Microsoft Clarity (ısı haritası + oturum kaydı, ücretsiz). Açılışı yavaşlatmasın diye sayfa yüklendikten SONRA boşta tembel yüklenir. -->
<script>
  (function(){
    function clarityYukle(){
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "xpvbhgctj3");
    }
    var boslaClarity = function(){ (window.requestIdleCallback || function(f){ setTimeout(f, 1); })(clarityYukle); };
    if(document.readyState === "complete") boslaClarity();
    else window.addEventListener("load", boslaClarity);
  })();
</script>
<!-- Service worker: kabuk önbelleği + "yeni sürüm hazır" bildirimi -->
<script>
  (function(){
    if(!("serviceWorker" in navigator)) return;
    if(location.protocol !== "https:" && location.hostname !== "localhost") return;
    // ============================================================
    //  MERKEZÎ SESSİZ GÜNCELLEME — PWA / mobil Chrome / Safari / PC birebir aynı.
    //  Toast/soru YOK. Yeni sürüm bulununca otomatik aktifleşir ve sayfa BİR KEZ
    //  tazelenir. Döngü koruması: son reload'dan bu yana 25 sn geçmeden tekrar
    //  yenilemez (CDN yayılımı / yarış / eski cihaz kaynaklı sonsuz döngüyü keser).
    // ============================================================
    var DONGU_MS = 25000;
    function sonReload(){ try{ return +sessionStorage.getItem("fl_sw_reload_ts")||0; }catch(e){ return 0; } }
    function simdi(){ try{ return Date.now(); }catch(e){ return 0; } }
    function tazele(){
      if(simdi() - sonReload() < DONGU_MS) return;   // yakın zamanda yenilendi → döngüyü kes
      try{ sessionStorage.setItem("fl_sw_reload_ts", String(simdi())); }catch(e){}
      location.reload();
    }
    var sonSkip = 0;
    function aktiflestir(reg){
      // beklemede sürümü otomatik devreye al (kısa aralıkta tekrar çağrılmasın)
      if(!reg || !reg.waiting) return;
      if(simdi() - sonSkip < 5000) return;
      sonSkip = simdi();
      reg.waiting.postMessage("FL_SKIP_WAITING");   // SW skipWaiting+claim → controllerchange → tazele()
    }
    // Sayfa yüklenirken zaten bir kontrolcü var mıydı? (İlk kurulumun claim'inde gereksiz reload olmasın.)
    var ilkKontrolVar = !!navigator.serviceWorker.controller;
    window.addEventListener("load", function(){
      // updateViaCache:"none" → tarayıcı sw.js'yi HER ZAMAN ağdan kontrol eder (HTTP önbelleğinden değil).
      navigator.serviceWorker.register("/sw.js", {updateViaCache:"none"}).then(function(reg){
        // Açılışta beklemede sürüm varsa hemen sessizce devreye al
        if(reg.waiting && navigator.serviceWorker.controller) aktiflestir(reg);
        reg.addEventListener("updatefound", function(){
          var yeni = reg.installing;
          if(!yeni) return;
          yeni.addEventListener("statechange", function(){
            if(yeni.state === "installed" && navigator.serviceWorker.controller) aktiflestir(reg);
          });
        });
        // Uygulama öne gelince + düzenli + tekrar çevrimiçi olunca güncelleme kontrol et
        document.addEventListener("visibilitychange", function(){
          if(document.visibilityState === "visible") reg.update().catch(function(){});
        });
        try{ reg.update().catch(function(){}); }catch(e){}                  // hemen bir kez
        setInterval(function(){ reg.update().catch(function(){}); }, 120000); // her 2 dk
        window.addEventListener("online", function(){ reg.update().catch(function(){}); });
      }).catch(function(){});
      // Yeni SW devraldığında sayfayı BİR KEZ tazele (döngü koruması tazele() içinde).
      var yenilendi = false;
      navigator.serviceWorker.addEventListener("controllerchange", function(){
        if(yenilendi) return;   // aynı sayfa yaşamında tek reload
        yenilendi = true;
        if(!ilkKontrolVar) return;   // ilk kurulumun claim'i → içerik zaten taze, reload gereksiz
        tazele();
      });
    });
  })();
</script>
