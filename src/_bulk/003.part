</script>

<script type="text/babel">
const { useState, useEffect, useMemo, useRef } = React;

/* ============================================================
   FAZ 8 (ONLINE) — Supabase yapılandırması
   TEST MODU: sadece IZINLI_MAILLER giriş yapabilir.
   Herkese açmak için: HERKESE_ACIK = true yap.
   ============================================================ */
const SB_URL = "https://crkestykdsnmfcmamxav.supabase.co";
const SB_ANAHTAR = "sb_publishable_sjfSVp0CmfnB4g8GecB0eA_BCHZheFB";
const IZINLI_MAILLER = ["fatiherol68@gmail.com"]; // test: sadece bunlar
const HERKESE_ACIK = true; // 🌍 YAYINDA — herkes üye olup girebilir
let sb = null;
try { if (typeof supabase !== "undefined" && supabase.createClient) sb = supabase.createClient(SB_URL, SB_ANAHTAR); }
catch(e){ console.warn("Supabase başlatılamadı:", e); }
/* ===== VERİ KATMANI READ-ONLY KİLİDİ =====
   Destek Modu / paylaşım-linki gibi salt-okunur durumlarda YAZMA çağrıları
   veri katmanında engellenir (sadece UI'da değil). Tek noktada, additive. */
let FL_SALT_OKUNUR = false;
function _fzRoStub(){
  const res={ data:null, error:{ message:"Salt-okunur mod: değişiklik yapılamaz." }, count:null };
  const h={ get(t,prop){ if(prop==='then')return t.then.bind(t); if(prop==='catch')return t.catch.bind(t); if(prop==='finally')return t.finally.bind(t); return ()=>new Proxy(Promise.resolve(res),h); } };
  return new Proxy(Promise.resolve(res),h);
}
if(sb){ try{
  const _from=sb.from.bind(sb);
  sb.from=(t)=>{ const qb=_from(t); ["insert","update","delete","upsert"].forEach(m=>{ if(typeof qb[m]==="function"){ const o=qb[m].bind(qb); qb[m]=(...a)=>FL_SALT_OKUNUR?_fzRoStub():o(...a); } }); return qb; };
  const _rpc=sb.rpc.bind(sb);
  const RPC_OKUR=new Set(["mac_kart_ozet","panel_metrikler","depo_orphan_bul","bekleyen_katilimlar","ben_buradayim","pazar_oyuncular"]);
  sb.rpc=(fn,args,opts)=>(FL_SALT_OKUNUR && !RPC_OKUR.has(fn))?_fzRoStub():_rpc(fn,args,opts);
  if(sb.storage && sb.storage.from){ const _sf=sb.storage.from.bind(sb.storage); sb.storage.from=(b)=>{ const o=_sf(b); ["upload","remove","update","move","copy"].forEach(m=>{ if(typeof o[m]==="function"){ const of=o[m].bind(o); o[m]=(...a)=>FL_SALT_OKUNUR?Promise.resolve({data:null,error:{message:"Salt-okunur mod."}}):of(...a); } }); return o; }; }
}catch(e){ console.warn("RO kilidi kurulamadı:",e); } }
const mailIzinli = (email)=> HERKESE_ACIK || IZINLI_MAILLER.map(m=>m.toLowerCase()).includes((email||"").trim().toLowerCase());
/* Paylaşılan lig linki: ...?lig=SLUG → salt-okunur public görünüm */
const PAYLASIM_SLUG = (()=>{ try{ return new URLSearchParams(window.location.search).get('lig')||null; }catch(e){ return null; } })();
/* Davet linki: ...?davet=TOKEN → takım/oyuncu katılım ekranı */
const DAVET_TOKEN = (()=>{ try{ return new URLSearchParams(window.location.search).get('davet')||null; }catch(e){ return null; } })();
const DAVET_URL = (token)=>{ try{ return window.location.origin + window.location.pathname + '?davet=' + token; }catch(e){ return '?davet='+token; } };
const PAYLASIM_URL = (slug)=>{ try{ return window.location.origin + window.location.pathname + '?lig=' + slug; }catch(e){ return '?lig='+slug; } };
/* SEO/Routing — üst düzey sayfalar URL'e yazılır: F5'te kalır, deep-link, paylaşılabilir. */
const SEO_TOP = ["ana","ligler","sohbet","profil","pazar","ayar","bildirim","takip","tumenler","admin"];
const BASLANGIC_SAYFA = (()=>{ try{ const p=new URLSearchParams(location.search).get('p'); return SEO_TOP.includes(p)?p:null; }catch(e){ return null; } })();
const MAC_ID = (()=>{ try{ return new URLSearchParams(location.search).get('mac')||null; }catch(e){ return null; } })();
const TAKIM_ID = (()=>{ try{ return new URLSearchParams(location.search).get('takim')||null; }catch(e){ return null; } })();
const OYUNCU_ID = (()=>{ try{ return new URLSearchParams(location.search).get('oyuncu')||null; }catch(e){ return null; } })();
const URL_FOR = (n)=>{ try{ const base=location.pathname; if(!n||!n.sayfa) return base;
  let dp='';
  if(n.sayfa==='mac'&&n.mac&&n.mac.id!=null) dp='mac='+encodeURIComponent(n.mac.id);
  else if(n.sayfa==='takim'&&n.takim&&n.takim.id!=null) dp='takim='+encodeURIComponent(n.takim.id);
  else if(n.sayfa==='oyuncu'&&n.oyuncu&&(n.oyuncu.player_id||n.oyuncu.id!=null)) dp='oyuncu='+encodeURIComponent(n.oyuncu.player_id||n.oyuncu.id);
  if(n.turnuva&&n.turnuva.paylasimSlug) return base+'?lig='+n.turnuva.paylasimSlug+(dp?'&'+dp:'');
  if(dp) return base+'?'+dp;
  if(n.sayfa==='ana') return base; if(SEO_TOP.includes(n.sayfa)) return base+'?p='+n.sayfa; return base;
}catch(e){ return location.pathname; } };
/* QR kod (paylaşım linki için) — data:image döner, kütüphane yoksa boş */
const qrData = (url)=>{ try{ if(typeof qrcode==="undefined"||!url) return ""; const qr=qrcode(0,"M"); qr.addData(url); qr.make(); return qr.createDataURL(5,10); }catch(e){ return ""; } };

/* Fotoğraf/logo yükleme — telefon fotoğrafını küçültür (max 512px, jpeg) → Supabase Storage → herkese açık URL.
   Giriş yapılmamışsa/sb yoksa hata döner (çağıran yer avatar'a düşer). */
let _webpTamam=null;
function _webpDestek(){ if(_webpTamam!==null) return _webpTamam; try{ _webpTamam=document.createElement("canvas").toDataURL("image/webp").indexOf("data:image/webp")===0; }catch(e){ _webpTamam=false; } return _webpTamam; }
/* 1:1 kare (merkez) kırp + 512px + WebP (destek yoksa JPEG) → en küçük dosya, gözle fark edilmez kalite */
function resimKucult(dosya, boy=512, kalite=0.82){
  return new Promise((res,rej)=>{
    try{
      const img=new Image(); const url=URL.createObjectURL(dosya);
      img.onload=()=>{
        const kaynak=Math.min(img.width,img.height);              // kısa kenar → kare
        const sx=(img.width-kaynak)/2, sy=(img.height-kaynak)/2;   // merkezden kırp
        const c=document.createElement("canvas"); c.width=boy; c.height=boy;
        const ctx=c.getContext("2d"); ctx.imageSmoothingEnabled=true; ctx.imageSmoothingQuality="high";
        ctx.drawImage(img, sx, sy, kaynak, kaynak, 0, 0, boy, boy);
        URL.revokeObjectURL(url);
        const tur=_webpDestek()?"image/webp":"image/jpeg";
        c.toBlob(b=> b?res(b):rej(new Error("kucultme")), tur, kalite);
      };
      img.onerror=()=>{ URL.revokeObjectURL(url); rej(new Error("resim okunamadi")); };
      img.src=url;
    }catch(e){ rej(e); }
  });
}
/* İnteraktif kırpma penceresi (sürükle + yakınlaştır → 1:1 kare). Vanilla DOM,
   React mount gerekmez. Blob döndürür (Kullan) veya null (Otomatik/kapat → çağıran
   merkezden otomatik kırpar). Böylece hiçbir çağrı noktası değişmez. */
function kirpDialog(dosya){
  return new Promise((resolve)=>{
    try{
      const acc=(getComputedStyle(document.documentElement).getPropertyValue('--accent').trim())||'#20E07A';
      const F=Math.min(300, (window.innerWidth||360)-72);
      const ov=document.createElement('div');
      ov.style.cssText='position:fixed;inset:0;z-index:5000;background:rgba(0,0,0,.82);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;padding:20px;';
      const box=document.createElement('div');
      box.style.cssText='background:#0c1219;border:1px solid rgba(255,255,255,.12);border-radius:18px;padding:18px;max-width:360px;width:100%;text-align:center;font-family:system-ui,-apple-system,sans-serif;';
      box.innerHTML='<div style="font-size:14px;font-weight:800;color:#eaf3ee;margin-bottom:3px">Fotoğrafı ayarla</div><div style="font-size:11px;color:#8ea298;margin-bottom:14px">Sürükle · yakınlaştır · kare seç</div>';
      const fw=document.createElement('div');
      fw.style.cssText='position:relative;width:'+F+'px;height:'+F+'px;margin:0 auto;border-radius:14px;overflow:hidden;background:#000;touch-action:none;cursor:grab;';
      const im=document.createElement('img');
      im.style.cssText='position:absolute;left:0;top:0;transform-origin:0 0;user-select:none;pointer-events:none;will-change:transform;';
      const ring=document.createElement('div'); ring.style.cssText='position:absolute;inset:0;border:2px solid '+acc+';border-radius:14px;pointer-events:none;';
      fw.appendChild(im); fw.appendChild(ring); box.appendChild(fw);
      const zr=document.createElement('input'); zr.type='range'; zr.min='1'; zr.max='4'; zr.step='0.01'; zr.value='1';
      zr.style.cssText='width:100%;margin:14px 0 2px;accent-color:'+acc+';'; box.appendChild(zr);
      const bt=document.createElement('div'); bt.style.cssText='display:flex;gap:9px;margin-top:12px;';
      const bA=document.createElement('button'); bA.textContent='Otomatik'; bA.style.cssText='flex:1;padding:11px;border-radius:11px;border:1px solid rgba(255,255,255,.14);background:transparent;color:#b7c8bf;font-weight:700;font-size:13px;cursor:pointer;';
      const bK=document.createElement('button'); bK.textContent='Kullan'; bK.style.cssText='flex:1.4;padding:11px;border-radius:11px;border:0;background:'+acc+';color:#04140c;font-weight:800;font-size:13px;cursor:pointer;';
      bt.appendChild(bA); bt.appendChild(bK); box.appendChild(bt);
      ov.appendChild(box); document.body.appendChild(ov);
      let iw=0,ih=0,base=1,zoom=1,ox=0,oy=0,drag=false,lx=0,ly=0;
      const url=URL.createObjectURL(dosya);
      function clamp(){ const dw=iw*base*zoom, dh=ih*base*zoom; ox=Math.min(0,Math.max(F-dw,ox)); oy=Math.min(0,Math.max(F-dh,oy)); }
      function render(){ clamp(); im.style.transform='translate('+ox+'px,'+oy+'px) scale('+(base*zoom)+')'; }
      im.onload=()=>{ iw=im.naturalWidth; ih=im.naturalHeight; base=F/Math.min(iw,ih); ox=(F-iw*base)/2; oy=(F-ih*base)/2; im.style.width=iw+'px'; im.style.height=ih+'px'; render(); };
      im.src=url;
      zr.oninput=()=>{ const c=F/2, pre=base*zoom, nx=(c-ox)/pre, ny=(c-oy)/pre; zoom=parseFloat(zr.value); const post=base*zoom; ox=c-nx*post; oy=c-ny*post; render(); };
      fw.onpointerdown=(e)=>{ drag=true; lx=e.clientX; ly=e.clientY; try{fw.setPointerCapture(e.pointerId);}catch(x){} fw.style.cursor='grabbing'; };
      fw.onpointermove=(e)=>{ if(!drag)return; ox+=e.clientX-lx; oy+=e.clientY-ly; lx=e.clientX; ly=e.clientY; render(); };
      fw.onpointerup=fw.onpointercancel=()=>{ drag=false; fw.style.cursor='grab'; };
      function kapat(r){ try{URL.revokeObjectURL(url);}catch(x){} try{document.body.removeChild(ov);}catch(x){} resolve(r); }
      bA.onclick=()=>kapat(null);
      ov.onclick=(e)=>{ if(e.target===ov) kapat(null); };
      bK.onclick=()=>{ try{ const s=base*zoom; const out=document.createElement('canvas'); out.width=512; out.height=512; const cx=out.getContext('2d'); cx.imageSmoothingEnabled=true; cx.imageSmoothingQuality='high'; cx.drawImage(im, -ox/s, -oy/s, F/s, F/s, 0,0,512,512); out.toBlob(b=>kapat(b||null),'image/webp',0.92); }catch(e){ kapat(null); } };
    }catch(e){ resolve(null); }
  });
}
/* Yükleme: dosyayı kendi klasörüne yazar → {uid}/{oyuncu|logo}/{uuid}.webp
   (Storage RLS: kullanıcı sadece kendi klasörüne yazabilir/silebilir.)
   eskiUrl verilirse ve bizim klasörümüzdeyse eski dosyayı siler (yer tutmasın). */
async function fotoYukle(dosya, klasor, eskiUrl){
  if(!sb) return {hata:"Giriş gerekli (bulut kapalı)."};
  if(!dosya) return {hata:"Dosya yok."};
  if(dosya.size>15*1024*1024) return {hata:"Fotoğraf çok büyük (max 15MB)."};
  try{
    let uid=null; try{ uid=((await sb.auth.getUser()).data.user||{}).id||null; }catch(e){}
    if(!uid) return {hata:"Giriş gerekli."};
    let kaynak = dosya;
    try{ if(typeof kirpDialog==='function'){ const c = await kirpDialog(dosya); if(c) kaynak = c; } }catch(e){}  // sürükle/yakınlaştır → kare; kapatırsa otomatik merkez-kare
    const kucuk = await resimKucult(kaynak);
    const ext = (kucuk.type==="image/webp")?"webp":"jpg";
    const uuid = (window.crypto&&crypto.randomUUID)?crypto.randomUUID():(Date.now()+"-"+Math.random().toString(36).slice(2,10));
    const yol = uid+"/"+(klasor||"genel")+"/"+uuid+"."+ext;
    const {error}=await sb.storage.from("fotolar").upload(yol, kucuk, {contentType:kucuk.type, upsert:false});
    if(error) return {hata:error.message};
    const {data}=sb.storage.from("fotolar").getPublicUrl(yol);
    // Eski dosyayı temizle (sadece bizim bucket + bizim uid klasörümüzdeyse RLS izin verir)
    try{ if(eskiUrl){ const p=String(eskiUrl).split("/fotolar/")[1]; if(p && p.indexOf(uid+"/")===0){ await sb.storage.from("fotolar").remove([decodeURIComponent(p.split("?")[0])]); } } }catch(e){}
    return {url:(data&&data.publicUrl)||""};
  }catch(e){ return {hata:String(e&&e.message||e)}; }
}

/* Bulut veri — tüm uygulama durumu, kullanıcı başına tek JSON satırı */
